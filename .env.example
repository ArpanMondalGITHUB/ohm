# Any OpenAI-compatible API works. Default is OpenRouter.
OHM_BASE_URL=https://openrouter.ai/api/v1
OHM_API_KEY=your-key-here
# A model that supports TOOLS. Example format: qwen/qwen3-coder:free
OHM_MODEL=
# Optional: comma-separated backup models, used when the main one is rate-limited
OHM_FALLBACK_MODELS=
# Optional: 1 = describe tools inside the prompt (for models with no tool support)
OHM_TEXT_TOOLS=0
# Optional: 1 = run bash commands without asking you first
OHM_YOLO=0
